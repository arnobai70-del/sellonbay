# Copy to .env.local. Find these in Supabase: Project settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Download links. DELIVERY_SECRET signs the 24-hour links (use a long random value). Delay switches are all off (0) by default.
DELIVERY_SECRET=
DELIVERY_TTL_SECONDS=86400
RELEASE_DELAY_MINUTES=0
RELEASE_DELAY_NEW_BUYER_DAYS=0
RELEASE_DELAY_HIGH_PRICE_CENTS=0
# Cloudflare Turnstile bot check. Empty means the always-pass TEST keys: fine for development, not for launch.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional switches
# FEATURE_TRIAL_COPY=1            # limited trial copy before purchase (default off)
# FEATURE_FREE_SAMPLE=0           # hide the free sample link (default on)
# NEXT_PUBLIC_FEATURE_DEMO_RANKING=0   # turn off the demo-quality lift in browse (default on)

# Orders and payments
# Signs payment webhooks. Required in production (there is no default there). Use a long random value.
PAYMENT_WEBHOOK_SECRET=
# Lets the scheduler call POST /api/cron/orders (Authorization: Bearer <value>).
CRON_SECRET=
# Shared rate limits (lib/rateLimit.ts). Needed when the site runs as two or more copies; empty means each copy counts in its own memory.
# From Upstash: the database's REST URL and token. The token is a secret.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Server error alerts (lib/monitor.ts, instrumentation.ts). Every error is a JSON line in the log anyway; with this https address
# (a Slack or Discord webhook, or a monitoring service that takes JSON) each kind of error is also posted, at most once a minute. A secret.
ERROR_WEBHOOK_URL=
# Salt for the hashed connection and device ids (lib/guard.ts). Use a long random value in production; changing it forgets old hashes and blocks.
GUARD_SALT=
# The address of the live site (sitemap, share cards, emails), for example https://sellonbay.com
NEXT_PUBLIC_SITE_URL=
# Only for a test server: lets the made-up example listings be bought with the test cards. Never set it on the live site.
# EXAMPLE_ORDERS=1
# The product name and its address live in lib/brand.ts. These override the address and the support email.
# NEXT_PUBLIC_BRAND_DOMAIN=
# NEXT_PUBLIC_BRAND_EMAIL=

# Free tools and AI cost control. Monthly token cap; 0 = OFF, not unlimited. Use a positive integer.
# AI_MONTHLY_TOKEN_BUDGET=2000000

# Internal ClamAV daemon on a trusted private network ONLY (never expose port 3310 publicly).
# Production listing and version approval requires ClamAV; omitting these blocks approval.
CLAMAV_HOST=
CLAMAV_PORT=3310
SCAN_REQUIRE_REAL=1

# Transactional email is opt-in; no real emails are sent until a verified Resend
# account, domain and API key are configured. Keep the API key server-only.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=SellOnBay <notifications@your-verified-domain.com>

# Visitor address for rate limits and quotas (lib/clientIp.ts). Set ONE once the host's setup is known, otherwise a visitor can fake their address
# by sending X-Forwarded-For. Behind Cloudflare only: CLIENT_IP_HEADER=cf-connecting-ip. Behind n proxies that append: TRUSTED_PROXY_HOPS=n.
# CLIENT_IP_HEADER=
# TRUSTED_PROXY_HOPS=
